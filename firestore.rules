// Firestore security rules for TourniReshet (project tournament-manager-cd0f4).
// Publish only after the app version that matches them (v4.62 or later) is live on production:
// Firebase console -> Firestore Database -> Rules -> paste -> Publish. Roll back from the rules history if needed.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    // Same document id the app builds in userDocId().
    function ownUserPath() {
      return /databases/$(database)/documents/users/$(email().replace('[^a-z0-9_.-]', '_'));
    }
    function isOwner() {
      return signedIn() && email() == 'noamsee@gmail.com';
    }
    // Keep in sync with DEVELOPER_EMAILS in app.js.
    function isDeveloper() {
      return signedIn() && email() in ['tomerseel@gmail.com'];
    }
    function isListedAdmin() {
      return signedIn() && exists(ownUserPath()) && get(ownUserPath()).data.role in ['admin', 'owner'];
    }
    function isManager() {
      return isOwner() || isDeveloper() || isListedAdmin();
    }

    // Tournaments: public to view; managers edit; only owner and developers delete.
    match /tournaments/{id} {
      allow read: if true;
      // The two old sample tournaments can never be recreated, even by a browser running an old version.
      allow create: if isManager() && !(id in ['tourney_active_2026', 'tourney_archive_2025']);
      allow update: if isManager();
      allow delete: if isOwner() || isDeveloper();
    }

    // Users: a signed-in user reads their own record, managers read the list, only the owner changes it.
    match /users/{id} {
      allow get: if isManager() || (signedIn() && id == email().replace('[^a-z0-9_.-]', '_'));
      allow list: if isManager();
      allow write: if isOwner();
    }

    // Audit trail: managers add entries under their own email; only the owner reads or deletes; nobody edits.
    match /audit_log/{id} {
      allow create: if isManager() && request.resource.data.email == email();
      allow read, delete: if isOwner();
      allow update: if false;
    }

    // Guest statistics: any visitor adds one small visit record; only the owner reads or deletes; nobody edits.
    match /guest_visits/{id} {
      allow create: if request.resource.data.keys().hasOnly(['ts', 'visitorId', 'tournamentId', 'tournamentName', 'groupKey', 'teamName', 'site'])
        && request.resource.data.ts is int
        && request.resource.data.tournamentName is string
        && request.resource.data.tournamentName.size() <= 300
        && request.resource.data.teamName is string
        && request.resource.data.teamName.size() <= 200;
      allow read, delete: if isOwner();
      allow update: if false;
    }
  }
}
